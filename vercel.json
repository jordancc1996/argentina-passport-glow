{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "header", "key": "x-forwarded-proto", "value": "http" },
        { "type": "host", "value": "www.argentinaresidence.com" }
      ],
      "destination": "https://argentinaresidence.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.argentinaresidence.com"
        }
      ],
      "destination": "https://argentinaresidence.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "statusCode": 301
    },
    {
      "source": "/:path*/index.html",
      "destination": "/:path*",
      "statusCode": 301
    },
    {
      "source": "/about-argentina",
      "destination": "/program",
      "statusCode": 301
    },
    {
      "source": "/golden-visa",
      "destination": "/program",
      "statusCode": 301
    },
    {
      "source": "/contact-us",
      "destination": "/contact",
      "statusCode": 301
    },
    {
      "source": "/blog/argentina-citizenship-by-investment-launch-date",
      "destination": "/research/argentina-citizenship-by-investment-launch-date",
      "statusCode": 301
    },
    {
      "source": "/blog/argentine-investment-landscape-golden-visa-value-proposition",
      "destination": "/research/argentine-investment-landscape-golden-visa-value-proposition",
      "statusCode": 301
    },
    {
      "source": "/blog/buenos-aires-real-estate-bull-market-analysis",
      "destination": "/research/buenos-aires-real-estate-bull-market-analysis",
      "statusCode": 301
    },
    {
      "source": "/blog/american-dream-argentina-golden-visa-solution",
      "destination": "/research/american-dream-argentina-golden-visa-solution",
      "statusCode": 301
    },
    {
      "source": "/blog/argentina-citizenship-investment-american-investors",
      "destination": "/research/argentina-citizenship-investment-american-investors",
      "statusCode": 301
    },
    {
      "source": "/blog/argentina-golden-visa-american-investors-2026",
      "destination": "/research/argentina-golden-visa-american-investors-2026",
      "statusCode": 301
    },
    {
      "source": "/blog",
      "destination": "/research",
      "statusCode": 301
    },
    {
      "source": "/guides",
      "destination": "/resources",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
